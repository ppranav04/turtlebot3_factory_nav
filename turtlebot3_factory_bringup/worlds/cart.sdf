<?xml version="1.0"?>
<!-- Pallet cart, 0.4 (x) x 0.6 (y) x 0.25 m. Static; moved by cart_patrol via set_pose. -->
<sdf version="1.9">
    <model name="cart">
        <static>true</static>
        <link name="link">
            <collision name="collision">
                <pose>0 0 0.125 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.4 0.6 0.25</size>
                    </box>
                </geometry>
            </collision>
            <visual name="visual">
                <pose>0 0 0.125 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.4 0.6 0.25</size>
                    </box>
                </geometry>
                <material>
                    <ambient>0.9 0.7 0.1 1</ambient>
                    <diffuse>0.9 0.7 0.1 1</diffuse>
                </material>
            </visual>
        </link>
    </model>
</sdf>

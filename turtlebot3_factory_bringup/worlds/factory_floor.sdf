<?xml version="1.0"?>
<sdf version="1.9">
<world name="factory_floor">

<physics name="1ms" type="ignored">
    <max_step_size>0.001</max_step_size>
    <real_time_factor>1.0</real_time_factor>
</physics>

  <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
<plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

<scene>
    <shadows>false</shadows>
</scene>

<light type="directional" name="sun">
    <cast_shadows>false</cast_shadows>
    <pose>0 0 10 0 0 0</pose>
    <diffuse>0.9 0.9 0.9 1</diffuse>
    <specular>0.2 0.2 0.2 1</specular>
    <direction>-0.3 0.2 -1.0</direction>
</light>

<model name="ground_plane">
    <static>true</static>
    <link name="link">
        <collision name="collision">
            <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
            <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
            <material>
                <ambient>0.6 0.6 0.6 1</ambient>
                <diffuse>0.6 0.6 0.6 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="walls">
    <static>true</static>
<link name="link">
    <!-- north wall -->
    <collision name="north_col">
        <pose>3.0 2.35 0.125 0 0 0</pose>
        <geometry>
            <box>
                <size>7.2 0.1 0.25</size>
            </box>
        </geometry>
    </collision>
    <visual name="north_vis">
        <pose>3.0 2.35 0.125 0 0 0</pose>
        <geometry>
            <box>
                <size> 7.2 0.1 0.25</size>
            </box>
        </geometry>
        <material>
            <ambient>0.75 0.75 0.7 1</ambient>
            <diffuse>0.75 0.75 0.7 1</diffuse>
        </material>
    </visual>
    <!-- south wall -->
    <collision name="south_col">
        <pose>3.0 -2.35 0.125 0 0 0</pose>
        <geometry>
            <box>
                <size>7.2 0.1 0.25</size>
            </box>
        </geometry>
        </collision>
        <visual name="south_vis">
            <pose>3.0 -2.35 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>7.2 0.1 0.25</size>
                </box>
            </geometry>
        <material>
            <ambient>0.75 0.75 0.7 1</ambient>
            <diffuse>0.75 0.75 0.7 1</diffuse>
            </material>
    </visual>
    <!-- west wall (dock / storage end) -->
    <collision name="west_col">
        <pose>-0.55 0 0.125 0 0 0</pose>
        <geometry>
            <box>
                <size>0.1 4.6 0.25</size>
            </box>
        </geometry>
    </collision>
    <visual name="west_vis">
        <pose>-0.55 0 0.125 0 0 0</pose>
        <geometry>
            <box>
                <size>0.1 4.6 0.25</size>
            </box>
        </geometry>
        <material>
            <ambient>0.75 0.75 0.7 1</ambient>
            <diffuse>0.75 0.75 0.7 1</diffuse>
        </material>
    </visual>
    <!-- east wall (machine end) -->
    <collision name="east_col">
        <pose>6.55 0 0.125 0 0 0</pose>
        <geometry>
            <box>
                <size>0.1 4.6 0.25</size>
            </box>
        </geometry>
    </collision>
    <visual name="east_vis">
        <pose>6.55 0 0.125 0 0 0</pose>
        <geometry>
            <box>
                <size>0.1 4.6 0.25</size>
            </box>
        </geometry>
        <material>
            <ambient>0.75 0.75 0.7 1</ambient>
            <diffuse>0.75 0.75 0.7 1</diffuse>
        </material>
    </visual>

</link>
</model>

<model name="racks">
    <static>true</static>
    <link name="link">
        <!-- north rack segment between CNC A and CNC B -->
        <collision name="north_rack_col">
            <pose>3.0 1.95 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>1.2 0.7 0.25</size>
                </box>
            </geometry>
        </collision>
        <visual name="north_rack_vis">
            <pose>3.0 1.95 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>1.2 0.7 0.25</size>
                </box>
            </geometry>
            <material>
                <ambient>0.25 0.35 0.55 1</ambient>
                <diffuse>0.25 0.35 0.55 1</diffuse>
            </material>
        </visual>
        <!-- central rack: y -0.6 to 0.6, splits the two aisles -->
        <collision name="central_rack_col">
            <pose>3.0 0 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>3.0 1.2 0.25</size>
                </box>
            </geometry>
        </collision>
        <visual name="central_rack_vis">
            <pose>3.0 0 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>3.0 1.2 0.25</size>
                </box>
            </geometry>
            <material>
                <ambient>0.25 0.35 0.55 1</ambient>
                <diffuse>0.25 0.35 0.55 1</diffuse>
            </material>
        </visual>
        <!-- south rack segment between CNC D and CNC C -->
        <collision name="south_rack_col">
            <pose>3.0 -1.95 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>1.2 0.7 0.25</size>
                </box>
            </geometry>
        </collision>
        <visual name="south_rack_vis">
            <pose>3.0 -1.95 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>1.2 0.7 0.25</size>
                </box>
            </geometry>
            <material>
                <ambient>0.25 0.35 0.55 1</ambient>
                <diffuse>0.25 0.35 0.55 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="dock_marker">
    <static>true</static>
    <link name="link">
        <!-- visual only: the robot drives onto it -->
        <visual name="visual">
            <pose>0 0 0.0025 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.3 0.3 0.005</size>
                </box>
            </geometry>
            <material>
                <ambient>0.9 0.75 0.1 1</ambient>
                <diffuse>0.9 0.75 0.1 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="storage_rack">
    <static>true</static>
     <pose>6.3 0 0.125 0 0 0</pose>
    <link name="link">
        <collision name="collision">
            <geometry>
                <box>
                    <size>0.4 1.0 0.25</size>
                </box>
            </geometry>
        </collision>
        <visual name="visual">
            <geometry>
                <box>
                    <size>0.4 1.0 0.25</size>
                </box>
            </geometry>
            <material>
                <ambient>0.2 0.55 0.3 1</ambient>
                <diffuse>0.2 0.55 0.3 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="pillars">
    <static>true</static>
    <link name="link">
        <!-- P1: south-west of CNC D -->
        <collision name="p1_col">
            <pose>0.2 -1.5 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.25 0.25 0.25</size>
                </box>
            </geometry>
        </collision>
        <visual name="p1_vis">
            <pose>0.2 -1.5 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.25 0.25 0.25</size>
                </box>
            </geometry>
            <material>
                <ambient>0.5 0.5 0.5 1</ambient>
                <diffuse>0.5 0.5 0.5 1</diffuse>
            </material>
        </visual>
        <!-- P2: east zone, beside the south aisle exit -->
        <collision name="p2_col">
            <pose>4.75 -0.75 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.25 0.25 0.25</size>
                </box>
            </geometry>
        </collision>
        <visual name="p2_vis">
            <pose>4.75 -0.75 0.125 0 0 0</pose>
            <geometry>
                <box>
                    <size>0.25 0.25 0.25</size>
                </box>
            </geometry>
            <material>
                <ambient>0.5 0.5 0.5 1</ambient>

            </material>
        </visual>
    </link>
</model>

<model name="cnc_a">
    <static>true</static>
    <pose>1.95 1.95 0.125 0 0 0</pose>
    <link name="link">
        <collision name="collision">
        <geometry>
            <box>
                <size>0.9 0.7 0.25</size>
            </box>
        </geometry>
        </collision>
        <visual name="visual">
            <geometry>
                <box>
                    <size>0.9 0.7 0.25</size>
                </box>
            </geometry>
            <material>
                <ambient>0.85 0.45 0.1 1</ambient>
                <diffuse>0.85 0.45 0.1 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="bin_a">
    <static>true</static>
    <pose>1.95 1.775 0.325 0 0 0</pose>
    <link name="link">
        <collision name="collision">
            <geometry>
                <box>
                    <size>0.25 0.25 0.15</size>
                </box>
            </geometry>
        </collision>
        <visual name="visual">
            <geometry>
                <box>
                    <size>0.25 0.25 0.15</size>
                </box>
            </geometry>
            <material>
                <ambient>0.15 0.3 0.8 1</ambient>
                <diffuse>0.15 0.3 0.8 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="cnc_b">
    <static>true</static>
    <pose>4.05 1.95 0.125 0 0 0</pose>
    <link name="link">
        <collision name="collision">
            <geometry>
                <box>
                    <size>0.9 0.7 0.25</size>
                </box>
            </geometry>
        </collision>
        <visual name="visual">
            <geometry>
                <box>
                    <size>0.9 0.7 0.25</size>
                </box>
            </geometry>
            <material>
                <ambient>0.85 0.45 0.1 1</ambient>
                <diffuse>0.85 0.45 0.1 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="bin_b">
    <static>true</static>
    <pose>4.05 1.775 0.325 0 0 0</pose>
    <link name="link">
        <collision name="name">
            <geometry>
                <box>
                    <size>0.25 0.25 0.15</size>
                </box>
            </geometry>
        </collision>
        <visual name="link">
            <geometry>
                <box>
                    <size>0.25 0.25 0.15</size>
                </box>
            </geometry>
            <material>
                <ambient>0.15 0.3 0.8 1</ambient>
                <diffuse>0.15 0.3 0.8 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="cnc_c">
    <static>true</static>
    <pose>4.05 -1.95 0.125 0 0 0</pose>
    <link name = "link">
        <collision name="collision">
            <geometry>
                <box>
                    <size>0.9 0.7 0.25</size>
                </box>
            </geometry>
        </collision>
        <visual name="visual">
            <geometry>
                <box>
                    <size>0.9 0.7 0.25</size>
                </box>
            </geometry>
            <material>
                <ambient>0.85 0.45 0.1 1</ambient>
                <diffuse>0.85 0.45 0.1 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="bin_c">
    <static>true</static>
    <pose>4.05 -1.775 0.325 0 0 0</pose>
    <link name="link">
        <collision name="name">
            <geometry>
                <box>
                    <size>0.25 0.25 0.15</size>
                </box>
            </geometry>
        </collision>
        <visual name="link">
            <geometry>
                <box>
                    <size>0.25 0.25 0.15</size>
                </box>
            </geometry>
            <material>
                <ambient>0.15 0.3 0.8 1</ambient>
                <diffuse>0.15 0.3 0.8 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="cnc_d">
    <static>true</static>
    <pose>1.95 -1.95 0.125 0 0 0</pose>
    <link name = "link">
        <collision name="collision">
            <geometry>
                <box>
                    <size>0.9 0.7 0.25</size>
                </box>
            </geometry>
        </collision>
        <visual name="visual">
            <geometry>
                <box>
                    <size>0.9 0.7 0.25</size>
                </box>
            </geometry>
            <material>
                <ambient>0.85 0.45 0.1 1</ambient>
                <diffuse>0.85 0.45 0.1 1</diffuse>
            </material>
        </visual>
    </link>
</model>

<model name="bin_d">
    <static>true</static>
    <pose>1.95 -1.775 0.325 0 0 0</pose>
    <link name="link">
        <collision name="name">
            <geometry>
                <box>
                    <size>0.25 0.25 0.15</size>
                </box>
            </geometry>
        </collision>
        <visual name="link">
            <geometry>
                <box>
                    <size>0.25 0.25 0.15</size>
                </box>
